[{"id":"st01","w":"photograph","syl":["PHO","to","graph"],"s":0,"rule":"Many three-syllable nouns stress the first syllable."},{"id":"st02","w":"photographer","syl":["pho","TO","gra","pher"],"s":1,"rule":"Words ending in -er from -graph move stress to the syllable before -graph."},{"id":"st03","w":"photographic","syl":["pho","to","GRA","phic"],"s":2,"rule":"Words ending in -ic stress the syllable just before -ic."},{"id":"st04","w":"economy","syl":["e","CON","o","my"],"s":1,"rule":"Words ending in -y after three or more syllables often stress the third syllable from the end."},{"id":"st05","w":"economic","syl":["e","co","NOM","ic"],"s":2,"rule":"-ic: stress the syllable before it."},{"id":"st06","w":"information","syl":["in","for","MA","tion"],"s":2,"rule":"Words ending in -tion stress the syllable just before -tion."},{"id":"st07","w":"education","syl":["ed","u","CA","tion"],"s":2,"rule":"-tion: stress the syllable before it."},{"id":"st08","w":"democracy","syl":["de","MOC","ra","cy"],"s":1,"rule":"-cy and -ty words often stress the third syllable from the end."},{"id":"st09","w":"democratic","syl":["dem","o","CRAT","ic"],"s":2,"rule":"-ic: stress the syllable before it."},{"id":"st10","w":"analysis","syl":["a","NAL","y","sis"],"s":1,"rule":"Learn this one; the stress moves in analyze and analytic."},{"id":"st11","w":"analytical","syl":["an","a","LYT","i","cal"],"s":2,"rule":"-ical: stress the syllable before -ical."},{"id":"st12","w":"biology","syl":["bi","OL","o","gy"],"s":1,"rule":"-ology words stress the syllable before -logy."},{"id":"st13","w":"psychology","syl":["psy","CHOL","o","gy"],"s":1,"rule":"-ology: stress the syllable before -logy."},{"id":"st14","w":"available","syl":["a","VAIL","a","ble"],"s":1,"rule":"-able usually keeps the stress of the base verb (avail)."},{"id":"st15","w":"comfortable","syl":["COM","for","ta","ble"],"s":0,"rule":"An exception many learners miss: stress the first syllable."},{"id":"st16","w":"environment","syl":["en","VI","ron","ment"],"s":1,"rule":"-ment does not take stress; it keeps the base stress."},{"id":"st17","w":"development","syl":["de","VEL","op","ment"],"s":1,"rule":"-ment: keep the base stress (develop)."},{"id":"st18","w":"necessary","syl":["NEC","es","sar","y"],"s":0,"rule":"-ary words often stress well before the ending in American English."},{"id":"st19","w":"particular","syl":["par","TIC","u","lar"],"s":1,"rule":"Learn this one by heart."},{"id":"st20","w":"opportunity","syl":["op","por","TU","ni","ty"],"s":2,"rule":"-ity: stress the syllable just before -ity."},{"id":"st21","w":"university","syl":["u","ni","VER","si","ty"],"s":2,"rule":"-ity: stress the syllable before it."},{"id":"st22","w":"technology","syl":["tech","NOL","o","gy"],"s":1,"rule":"-ology: stress the syllable before -logy."},{"id":"st23","w":"interesting","syl":["IN","ter","est","ing"],"s":0,"rule":"Stress the first syllable; -ing never takes stress."},{"id":"st25","w":"hypothesis","syl":["hy","POTH","e","sis"],"s":1,"rule":"Learn this one; compare hypothetical."},{"id":"st26","w":"hypothetical","syl":["hy","po","THET","i","cal"],"s":2,"rule":"-ical: stress the syllable before -ical."},{"id":"st27","w":"geography","syl":["ge","OG","ra","phy"],"s":1,"rule":"-graphy: stress the syllable before -graphy."},{"id":"st28","w":"significant","syl":["sig","NIF","i","cant"],"s":1,"rule":"Learn this one by heart."},{"id":"st29","w":"phenomenon","syl":["phe","NOM","e","non"],"s":1,"rule":"Learn this one by heart."},{"id":"st30","w":"category","syl":["CAT","e","go","ry"],"s":0,"rule":"Stress the first syllable."}]